# Server Configuration
PORT=3000
NODE_ENV=development

# Mistral AI Configuration
# Get your API key from https://console.mistral.ai/
MISTRAL_API_KEY=your_mistral_api_key_here
# Available models: mistral-small-latest, mistral-large-latest, open-mistral-nemo
MISTRAL_MODEL=mistral-small-latest

# Telegram Bot Configuration
# Create a bot using @BotFather on Telegram (https://t.me/BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Comma-separated list of Telegram User IDs allowed to access the bot (send /start to @userinfobot to find your ID)
ALLOWED_TELEGRAM_USER_IDS=123456789

# WhatsApp Client Configuration
# Path to Google Chrome executable (leave blank to auto-detect standard locations)
CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# Run Chrome in headless mode (true / false)
HEADLESS=true
# Max messages to fetch per chat for summarization by default
DEFAULT_SUMMARY_MESSAGE_LIMIT=100
